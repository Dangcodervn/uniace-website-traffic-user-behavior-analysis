				         or Text.Contains([Name], "Đường dẫn tài liệu", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Thảo luận và đánh giá", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "THÔNG TIN GIẢNG VIÊN", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Bạn đã tìm", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Đăng ký tài khoản", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Hướng dẫn đăng ký khóa học", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "HƯỚNG DẪN QUAN TRỌNG", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Chuẩn bị -", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "KHÓA HỌC CỦA TÔI", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "TRUNG TÂM CHĂM SÓC KHÁCH HÀNG", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Sale Countdown", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "UNIACE KHÁC BIỆT", Comparer.OrdinalIgnoreCase)
				         or Text.StartsWith([Name], "Tháng Bảy 2020")
				         or Text.StartsWith([Name], "Tháng Chín 2020")
				         or Text.StartsWith([Name], "Tháng Sáu 2020")
				         or Text.StartsWith([Name], "Tháng Tư 2020")
				         or Text.StartsWith([Name], "2020-")
				         then "Trang khác"
				    else if Text.Contains([Name], "SOFT") then "Kỹ năng mềm"
				    else if Text.Contains([Name], "High Performer", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "UAC")
				         or Text.Contains([Name], "Mindset Foundation", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Coaching", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Growth Hacking", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "HIỆU SUẤT CAO", Comparer.OrdinalIgnoreCase)
				         then "Chương trình đào tạo"
				    else if Text.Contains([Name], "TECH", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "DATA", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "dữ liệu", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Excel", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Pivot", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Query", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "SQL", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "DAX", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Dashboard", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "phân tích", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Business Intelligence", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Slicer", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Power BI", Comparer.OrdinalIgnoreCase)
				         or Text.StartsWith([Name], "Làm quen", Comparer.OrdinalIgnoreCase)
