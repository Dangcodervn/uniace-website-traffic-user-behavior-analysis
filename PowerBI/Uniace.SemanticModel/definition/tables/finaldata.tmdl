				         or Text.Contains([Name], "Ngữ cảnh", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Conditional Formatting", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Primary Key", Comparer.OrdinalIgnoreCase)
