				    else if [Type] <> "page" then "Trang khác"
				    else if [Name] = null or [Name] = "" then "Trang khác"
				    else if Text.Contains([Name], "Chính sách", Comparer.OrdinalIgnoreCase) 
				         or Text.Contains([Name], "Điều khoản", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Liên hệ", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "FAQ", Comparer.OrdinalIgnoreCase)
