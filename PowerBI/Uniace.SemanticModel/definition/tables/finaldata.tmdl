				    #"Uppercased Text" = Table.TransformColumns(#"Replaced Value10",{{"School", Text.Upper, type text}}),
				    #"Replaced Value11" = Table.ReplaceValue(#"Uppercased Text",null,"Not Student",Replacer.ReplaceValue,{"School"}),
				    #"Added Conditional Column2" = Table.AddColumn(#"Replaced Value11", "Referrer Type", each if Text.Contains([MA Referrer], "chgif") then "Uniace" 
				    else if Text.Contains([MA Referrer], "google") then "Google" 
				    else if Text.Contains([Type], "template") then "Email" 
				    else if Text.Contains([MA Referrer], "uniace") then "Uniace" 
				    else if Text.Contains([MA Referrer], "coccoc") then "Cốc cốc" 
				    else if Text.Contains([MA Referrer], "zalo") then "Zalo" 
				    else if Text.Contains([MA Referrer], "insta") then "Instagram" 
				    else if Text.Contains([MA Referrer], "messenger") then "Facebook" 
				    else if Text.Contains([MA Referrer], "facebook") then "Facebook" 
				    else if Text.Contains([MA Referrer], "yahoo") then "Yahoo" 
				    else if Text.Contains([MA Referrer], "bing") then "Bing" 
				    else if Text.Contains([MA Referrer], "beacon") then "Bio" 
				    else if Text.Contains([MA Referrer], "baidu") then "Baidu" 
				    else if Text.Contains([MA Referrer], "duckduckgo") then "DuckDuckGo" 
				    else if Text.Contains([MA Referrer], "ecosia") then "Ecosia" 
				    else if Text.Contains([MA Referrer], "yandex") then "Yandex" 
				    else if Text.Contains([MA Referrer], "tiktok") then "Tiktok" 
				    else if Text.Contains([MA Referrer], "form") then "Form" 
				    else if Text.Contains([MA Referrer], "koc") then "KOC" 
				    else if Text.Contains([MA Referrer], "many.link") then "Bio" 
				    else if Text.Contains([MA Referrer], "youtube") then "Youtube" 
				    else if [MA Referrer] = null or [MA Referrer] = "" then "Direct" 
				    else "Other"),
				    #"Added Custom" = Table.AddColumn(#"Added Conditional Column2", "Content Type", each if Text.Contains([Name], "Young", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "VYT")
