table finaldata
	lineageTag: 89c377ab-4bb8-4b28-bac5-d6e24d423c63

	measure PageViews = CALCULATE(COUNTROWS(finaldata), finaldata[Type] = "page")
		formatString: 0
		lineageTag: c1a1b1a0-1111-4a11-8111-000000000001

	measure 'Unique Visitors' =
			CALCULATE(
			    DISTINCTCOUNT(finaldata[Visitor ID]),
			    NOT(ISBLANK(finaldata[Visitor ID]))
			)
		formatString: 0
		lineageTag: c1a1b1a0-1111-4a11-8111-000000000002

	measure 'Registered Users' =
			CALCULATE(
			    DISTINCTCOUNT(finaldata[Email]),
			    finaldata[Email] <> "N/A"
			)
		formatString: 0
		lineageTag: c1a1b1a0-1111-4a11-8111-000000000003

	measure 'New Registrations' = CALCULATE(COUNTROWS(finaldata), finaldata[Name] IN {"New Account", "UAC Register"})
		formatString: 0
		lineageTag: c1a1b1a0-1111-4a11-8111-000000000004

	measure 'Completed Orders' = CALCULATE(DISTINCTCOUNT(finaldata[Email]), finaldata[Name] = "Completed Order")
		formatString: 0
		lineageTag: c1a1b1a0-1111-4a11-8111-000000000005

	measure 'Conversion Rate' = DIVIDE([Completed Orders], [Unique Visitors])
		formatString: 0%
		lineageTag: c1a1b1a0-1111-4a11-8111-000000000006

	measure 'Registration Rate' = DIVIDE([New Registrations], [PageViews])
		formatString: 0%
		lineageTag: c1a1b1a0-1111-4a11-8111-000000000007

	measure 'Avg PageViews per Day' = DIVIDE([PageViews], DISTINCTCOUNT(finaldata[Only Date]))
		formatString: 0
		lineageTag: c1a1b1a0-1111-4a11-8111-000000000008

	measure '% Organic Traffic' = DIVIDE(CALCULATE([PageViews], finaldata[Traffic Type] = "Organic"), [PageViews])
		formatString: 0%
		lineageTag: c1a1b1a0-1111-4a11-8111-000000000009

	measure '% Social Traffic' = DIVIDE(CALCULATE([PageViews], finaldata[Traffic Type] = "Social"), [PageViews])
		formatString: 0%
		lineageTag: c1a1b1a0-1111-4a11-8111-00000000000a

	measure '% Direct Traffic' = DIVIDE(CALCULATE([PageViews], finaldata[Traffic Type] = "Trực tiếp"), [PageViews])
		formatString: 0%
		lineageTag: c1a1b1a0-1111-4a11-8111-00000000000b

	measure '% Sinh viên' =
			DIVIDE(
			    CALCULATE([Unique Visitors], finaldata[Customer Type] = "Sinh viên"),
			    [Unique Visitors]
			)
		formatString: 0%
		lineageTag: c1a1b1a0-1111-4a11-8111-00000000000c

	measure 'Email Opens' = CALCULATE(COUNTROWS(finaldata), finaldata[Type] = "templates_open")
		formatString: 0
		lineageTag: c1a1b1a0-1111-4a11-8111-00000000000d

	measure 'Email Clicks' = CALCULATE(COUNTROWS(finaldata), finaldata[Type] = "templates_click")
		formatString: 0
		lineageTag: c1a1b1a0-1111-4a11-8111-00000000000e

	measure 'Email Click Rate' = DIVIDE([Email Clicks], [Email Opens])
		formatString: 0%
		lineageTag: c1a1b1a0-1111-4a11-8111-00000000000f

