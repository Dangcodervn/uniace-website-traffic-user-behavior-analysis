				         or Text.Contains([Name], "Fiscal Year", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Combine", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Show value as", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Summarize value", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Tỉ trọng", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "phím tắt", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "doanh số", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "mật độ giao dịch", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "nhóm dẫn đầu", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "xu hướng kinh doanh", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "bộ nhớ đệm", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "quản lý dòng và cột", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "xlsb", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "bảng số liệu", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "bảng đối tượng", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "SSBI", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "hệ thống BI", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "công thức của một bước", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "(PQ ", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "tổng quát tới chi tiết", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Cấu trúc WITH", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Tùy biến giao diện", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Chọn layout", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "tỉ lệ đóng góp", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "sức bán", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "định dạng số", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "lập trình", Comparer.OrdinalIgnoreCase)
				         or [Name] = "A1.Tài liệu - uniace.vn"
				         or [Name] = "A4.Tài liệu - uniace.vn"
				         or [Name] = "F1.Tài liệu - uniace.vn"
				         or [Name] = "F2.Tài liệu - uniace.vn"
				         or [Name] = "F3.Tài liệu - uniace.vn"
				         or [Name] = "F6.Tài liệu - uniace.vn"
				         or [Name] = "I1.Tài liệu - uniace.vn"
				         or [Name] = "I2.Tài liệu - uniace.vn"
				         then "Dữ liệu"
				    else "Kỹ năng mềm"),
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Traffic Type", each if [Referrer Type] = "Uniace" then "Nội bộ"
				    else if List.Contains({"Google", "Cốc cốc", "Baidu", "DuckDuckGo", "Ecosia", "Yandex", "Bing"}, [Referrer Type]) then "Organic"
				    else if List.Contains({"Facebook", "Zalo", "Instagram", "Tiktok", "Youtube", "Bio", "KOC"}, [Referrer Type]) then "Social"
