				         or Text.Contains([Name], "Field", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Filter", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Quick Access Toolbar", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "PQL")
