				         or Text.Contains([Name], "Purchase", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Tài khoản", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Lưu trữ", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Tác giả", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Không tìm thấy trang", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Draft", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Demo", Comparer.OrdinalIgnoreCase)
				         or Text.Contains([Name], "Ebook", Comparer.OrdinalIgnoreCase)
