				    #"Replaced Value5" = Table.ReplaceValue(#"Replaced Value4","stu.","",Replacer.ReplaceText,{"School"}),
				    #"Replaced Value6" = Table.ReplaceValue(#"Replaced Value5","st.","",Replacer.ReplaceText,{"School"}),
				    #"Replaced Value7" = Table.ReplaceValue(#"Replaced Value6","sv.","",Replacer.ReplaceText,{"School"}),
				    #"Replaced Value8" = Table.ReplaceValue(#"Replaced Value7","s.","",Replacer.ReplaceText,{"School"}),
				    #"Replaced Value9" = Table.ReplaceValue(#"Replaced Value8","sinhvien.","",Replacer.ReplaceText,{"School"}),
